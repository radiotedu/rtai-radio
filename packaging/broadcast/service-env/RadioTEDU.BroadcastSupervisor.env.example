# Store the real values only in the ACL-protected target-machine service environment.
STATION_PROFILES_DIR=C:\RadioTEDU\config\stations
QWEN_TTS_SERVICE_URL=http://127.0.0.1:8090
PUBLIC_SYNC_URL=https://api.radiotedu.com
PUBLIC_SYNC_INTERVAL_SECONDS=10
PUBLIC_COMPATIBILITY_ENABLED=false
RADIOTEDU_AGENT_ID=school-radio-pc
RADIOTEDU_AGENT_SCOPE=agent:playout
RADIOTEDU_EN_SOURCE_CREDENTIALS=<read-from-protected-secret-store>
RADIOTEDU_FR_SOURCE_CREDENTIALS=<read-from-protected-secret-store>
RADIOTEDU_EN_SNAPSHOT_SECRET=<read-from-protected-secret-store>
RADIOTEDU_FR_SNAPSHOT_SECRET=<read-from-protected-secret-store>
